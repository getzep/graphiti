# Graphiti Studio local development. Never commit a real credential.
ARK_API_KEY=replace-with-a-new-ark-api-key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_CHAT_MODEL=replace-with-your-ark-endpoint-id
ARK_STRUCTURED_OUTPUT_MODE=prompt_only
ARK_TEMPERATURE=0
ARK_MAX_TOKENS=8192

# local_hash is for bootstrap/development. See docs/quickstart-zh.md for production.
EMBEDDING_PROVIDER=local_hash
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_MODEL_NAME=local-feature-hash
EMBEDDING_DIM=1024

DB_BACKEND=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-strong-local-password
NEO4J_DATABASE=neo4j

SOURCE_STATE_PATH=data/source_state.db
UPLOAD_ROOT=data/uploads
MAX_UPLOAD_BYTES=26214400
SYNC_CONCURRENCY=1
MCP_PUBLIC_URL=http://localhost:8001/mcp/

OAUTH_PUBLIC_BASE_URL=http://localhost:8000
OAUTH_TOKEN_ENCRYPTION_KEY=
OAUTH_COOKIE_SECURE=false

# Administrator-owned Feishu OAuth application. Ordinary users only click Connect.
# Callback: http://localhost:8000/api/oauth/feishu/callback
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE_URL=https://open.feishu.cn/open-apis
FEISHU_OAUTH_SCOPES=offline_access space:document:retrieve docx:document:readonly drive:file:readonly

# MeeGo OAuth + MCP host. Plugin fields below are legacy compatibility only.
MEEGO_HOST=project.feishu.cn
MEEGO_PLUGIN_ID=
MEEGO_PLUGIN_SECRET=
MEEGO_USER_KEY=
MEEGO_BASE_URL=https://project.feishu.cn/open_api

GRAPHITI_TELEMETRY_ENABLED=false
