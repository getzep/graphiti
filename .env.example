# Copy this file to .env. Keep .env out of version control.
# If a credential has appeared in chat, logs, or screenshots, rotate it before use.

# Volcengine Ark chat endpoint (required for ingest/extraction)
ARK_API_KEY=replace-with-a-new-ark-api-key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_CHAT_MODEL=ep-20260805000513-69bnd
STRUCTURED_OUTPUT_MODE=json_schema
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=8192

# Development default. Production should use an independent embedding endpoint.
EMBEDDING_PROVIDER=local_hash
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_MODEL_NAME=local-feature-hash
EMBEDDING_DIM=1024

# Neo4j Community uses the single database named neo4j.
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-strong-local-password
NEO4J_DATABASE=neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Local ports and sync persistence
GRAPHITI_SERVER_PORT=8000
GRAPHITI_MCP_PORT=8001
MCP_PUBLIC_URL=http://localhost:8001/mcp/
MAX_UPLOAD_BYTES=26214400
SYNC_CONCURRENCY=2
SEMAPHORE_LIMIT=2
USER_ID=mcp_user

# Browser OAuth. The public base URL must exactly match the site opened by users.
OAUTH_PUBLIC_BASE_URL=http://localhost:8000
# Optional for local Compose: if empty, Studio creates a persistent key in graphiti_data.
# Production should inject a Base64URL-encoded 32-byte key through a secret manager.
OAUTH_TOKEN_ENCRYPTION_KEY=
OAUTH_COOKIE_SECURE=false

# Vaka's server-side Feishu OAuth client. End users only see the standard consent page.
# Register this callback: http://localhost:8000/api/oauth/feishu/callback
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE_URL=https://open.feishu.cn/open-apis
FEISHU_OAUTH_SCOPES=offline_access space:document:retrieve docx:document:readonly

# MeeGo user OAuth discovers/registers its client against the site in your MeeGo URL.
# Example: https://meego.larkoffice.com/<project_key>/... -> meego.larkoffice.com
MEEGO_HOST=meego.larkoffice.com

# Legacy connector compatibility only. New Studio sources use OAuth and do not ask users
# for plugin credentials, tokens, user keys, project keys, or folder tokens.
MEEGO_PLUGIN_ID=
MEEGO_PLUGIN_SECRET=
MEEGO_USER_KEY=
MEEGO_BASE_URL=https://meego.larkoffice.com/open_api

# Legacy root Compose / optional providers. Retained for backward compatibility.
OPENAI_API_KEY=
NEO4J_URI=
NEO4J_PORT=
FALKORDB_URI=
FALKORDB_PORT=6379
FALKORDB_USER=
FALKORDB_PASSWORD=
USE_PARALLEL_RUNTIME=
GITHUB_SHA=
MAX_REFLEXION_ITERATIONS=
ANTHROPIC_API_KEY=
