# Used with config/config-ark-neo4j.yaml. Never commit a real credential.
ARK_API_KEY=replace-with-a-new-ark-api-key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_CHAT_MODEL=ep-20260805000513-69bnd

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-strong-local-password
NEO4J_DATABASE=neo4j
USER_ID=mcp_user
SEMAPHORE_LIMIT=2
VAKA_STATE_PATH=../server/data/source_state.db

# Optional production override: use a dedicated embedding endpoint.
# The model and dimensions must match the REST service sharing this Neo4j database.
# EMBEDDER__PROVIDER=openai
# EMBEDDER__MODEL=replace-with-your-embedding-endpoint-id
# EMBEDDER__DIMENSIONS=replace-with-the-endpoint-dimensions
# EMBEDDER__PROVIDERS__OPENAI__API_KEY=replace-with-an-embedding-api-key
# EMBEDDER__PROVIDERS__OPENAI__API_URL=https://ark.cn-beijing.volces.com/api/v3

GRAPHITI_TELEMETRY_ENABLED=false
